[Unit]
Description=Push Daily Firehose PostgreSQL backup to restricted TrueNAS SSH
Documentation=file:/home/ubuntu/daily-firehose/docs/operations/postgresql-backups.md
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/home/ubuntu/daily-firehose/docker-compose.yml

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/daily-firehose
UMask=0077
LoadCredential=ssh-private-key:/etc/daily-firehose-backup/ssh/id_ed25519
LoadCredential=ssh-known-hosts:/etc/daily-firehose-backup/ssh/known_hosts
Environment=BACKUP_SSH_IDENTITY_FILE=%d/ssh-private-key
Environment=BACKUP_SSH_KNOWN_HOSTS_FILE=%d/ssh-known-hosts
ExecStart=/usr/bin/python3 -m scripts.postgres_backup
TimeoutStartSec=2h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
