# Copy to .env for local development. These development values are rejected
# when DJANGO_ENV=production; follow README.md's production checklist instead.
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
WEB_PORT=8000

POSTGRES_DB=daily_firehose
POSTGRES_USER=daily_firehose
POSTGRES_PASSWORD=daily_firehose_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

LINKDING_URL=https://linkding.reedfish-regulus.ts.net
LINKDING_TOKEN=

# Enables signed links that save an article and redirect to it.
AGENT_LINK_SECRET=
AGENT_LINK_USERNAME=

# Shared secret in the Postmark inbound webhook URL.
POSTMARK_INBOUND_SECRET=
POSTMARK_INBOUND_EMAIL=95d8c50c7df8d1ca38d7a6f55ee5a311@inbound.postmarkapp.com

# Used by the refresh-feeds compose service. Feed downloads also enforce these
# per-request transport and response-size bounds.
FEED_REFRESH_SECONDS=3600
FEED_FETCH_CONNECT_TIMEOUT_SECONDS=5
FEED_FETCH_READ_TIMEOUT_SECONDS=20
FEED_FETCH_TOTAL_TIMEOUT_SECONDS=60
FEED_FETCH_MAX_BYTES=5000000
FEED_FETCH_MAX_REDIRECTS=3
